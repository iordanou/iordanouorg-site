@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,500;0,600;1,400&display=swap');

/* Base */

:root {
  color-scheme: light;
}

body {
  font-family: "Source Serif 4", Georgia, serif;
  font-size: 18px;
  line-height: 1.75;
  color: #222;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body.dark {
  background: #fff !important;
  color: #222 !important;
}

/* Main content */

.post-content {
  font-family: "Source Serif 4", Georgia, serif;
  font-size: 1.08rem;
  line-height: 1.72;
  margin-top: 2rem;
}

.post-content p {
  margin-bottom: 1.25em;
}

.post-content p:first-of-type {
  margin-top: 0.2rem;
}

/* Global serif enforcement */

.post,
.posts,
.posts-group,
.posts-list,
.posts-list-item,
.post-item,
.post-item-inner,
.post-item a,
.post-item-title,
.posts-group .post-title,
.posts-group .post-item-title,
.posts-group .post-item a,
.posts-list a,
.posts-list-item a,
.post-year,
.posts-group .post-year,
.post-title,
.post-title a,
.homepage-content h1,
main[aria-role="main"] h1,
h1, h2, h3,
.subtitle,
.post-excerpt,
.post-info,
.footer,
.menu__inner,
.menu__inner a,
.logo,
.logo__text,
.post-content li,
.post-content blockquote,
.post-content ul,
.post-content ol {
  font-family: "Source Serif 4", Georgia, serif !important;
}

/* Layout */

.post,
.posts,
.posts-group {
  max-width: 720px;
  margin: 0 auto;
}

/* Archive */

.posts {
  max-width: 760px;
}

.posts-group {
  max-width: 760px;
  margin-top: 1.4rem;
}

.posts-group .post-year {
  font-size: 1.6rem;
  color: #a3a3a3;
  font-weight: 400;
  min-width: 78px;
}

.post-item {
  padding: 0.28rem 0;
}

.posts-group .post-item {
  border-bottom: 1px dotted #dddddd;
}

.posts-group .post-item:last-child {
  border-bottom: none;
}

.post-item a,
.post-item-title {
  font-size: 1.12rem;
  line-height: 1.35;
}

.post-item a {
  color: #1f1f1f;
}

.post-item a:hover {
  color: #000;
}

.post-item time {
  font-size: 1rem;
  color: #999;
}

/* Titles */

.post-title,
.post-title a {
  font-size: 2.8rem;
  line-height: 1.15;
  font-weight: 500;
  letter-spacing: -0.01em;
  margin-bottom: 0.9rem;
}

/* Homepage */

main[aria-role="main"] {
  display: flex;
  justify-content: center;
  padding: 90px 20px 40px;
  text-align: center;
}

.home-intro {
  max-width: 760px;
}

.home-intro h1 {
  font-size: 3.15rem;
  line-height: 1.04;
  margin-bottom: 1rem;
}

.home-intro .subtitle {
  font-size: 1.02rem;
  color: #555;
  max-width: 34rem;
  margin: 0 auto 1.2rem;
}

/* Social */

.home-social {
  margin: 0.7rem 0 1.1rem;
}

.home-social a {
  display: inline-flex;
  margin: 0 0.42rem;
  color: #555;
}

.home-social svg {
  width: 18px;
  height: 18px;
}

/* Footer */

.footer {
  font-size: 0.74rem;
  color: #aaa;
  text-align: center;
  padding: 1rem 0 1.6rem;
}

/* Mobile — SAFE (no layout overrides) */

@media (max-width: 900px) {

  .post-title,
  .post-title a {
    font-size: 1.95rem;
    line-height: 1.1;
  }

  .post {
    padding: 0 16px;
  }

  .post-item a {
    font-size: 1.04rem;
  }

  .posts-group .post-year {
    font-size: 1.45rem;
  }

  .home-social svg {
    width: 17px;
    height: 17px;
  }
}
