@import url('https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,600;1,400&display=swap');

body {
/*  font-family: "Libre Caslon Text", Georgia, serif;*/
  font-family: "adobe-caslon-pro", serif;
/*  font-family: "Source Serif 4", serif;*/
  font-size: 18px;
  line-height: 1.75;
}

.post-content {
  font-family: "Libre Caslon Text", Georgia, serif;
  font-size: 1.08rem;
  line-height: 1.85;
}

.post-content p {
  margin-bottom: 1.35em;
}

.post,
.posts,
.posts-group,
.posts-list,
.posts-list-item,
.post-item,
.post-item-inner {
  font-family: "Libre Caslon Text", Georgia, serif !important;
}

.post {
  max-width: 760px;
  margin: 0 auto;
}

.posts {
  max-width: 760px;
  margin: 0 auto;
}

.posts-group {
  max-width: 760px;
}

.post-item {
  padding: 0.35rem 0;
}

.post-item a,
.post-item-title,
.post-item .post-title,
.posts-group .post-title,
.posts-group .post-item-title,
.posts-group .post-item a,
.posts-list a,
.posts-list-item a {
  font-family: "Libre Caslon Text", Georgia, serif !important;
  font-weight: 400 !important;
}

.post-year,
.posts-group .post-year {
  font-family: "Libre Caslon Text", Georgia, serif !important;
  font-weight: 400 !important;
}

.post-title,
.post-title a {
  font-family: "Libre Caslon Text", Georgia, serif !important;
  font-weight: 600 !important;
  line-height: 1.2;
}

.homepage-content h1,
main[aria-role="main"] h1,
h1, h2, h3 {
  font-family: "Libre Caslon Text", Georgia, serif !important;
}

.subtitle,
.post-excerpt,
.post-info,
.footer,
.menu__inner,
.menu__inner a {
  font-family: "Libre Caslon Text", Georgia, serif !important;
}

.logo,
.logo__text {
  font-family: "Libre Caslon Text", Georgia, serif !important;
  font-weight: 400 !important;
}

.logo__cursor,
.logo__mark {
  display: none !important;
}

.header__inner {
  width: 900px;
}

a {
  text-underline-offset: 0.12em;
}

.sharing-buttons {
  display: none;
}
